# Copy this file to .env.local for local development.
# On Netlify, set these under Site settings -> Environment variables.

# Public site origin, used for canonical URLs, the sitemap, robots.txt, and
# Open Graph / Twitter card tags. No trailing slash.
# Use your Netlify preview subdomain for now, then swap to the custom domain at launch.
NEXT_PUBLIC_SITE_URL=https://peadar-jolliffe-byrne.netlify.app

# Address that receives artwork enquiries (the "Make an enquiry" mailto target).
NEXT_PUBLIC_ENQUIRY_EMAIL=peadarjb@gmail.com

# Artflow is a local, review-gated artwork pipeline. Copy these entries to a
# local `.env` or `.env.artflow`; never commit the real Drive for Desktop path
# or API keys. The verified cloud folder is Backup/Peadar/edits.
ARTFLOW_SOURCE_PATH=C:\\path\\from-google-drive-for-desktop\\Backup\\Peadar\\edits
ARTFLOW_DATABASE_PATH=manifest.sqlite
ARTFLOW_WORKING_PATH=working
ARTFLOW_APPROVED_PATH=approved
ARTFLOW_WEBSITE_ROOT=.
ARTFLOW_AI_PROVIDER=rules
ARTFLOW_OPENAI_MODEL=
ARTFLOW_OPENAI_API_KEY=
ARTFLOW_GEMINI_MODEL=
ARTFLOW_GEMINI_API_KEY=

# Verified against scripts/optimize-images.mjs. These values preserve the
# existing portfolio output convention and may be overridden as JSON.
ARTFLOW_VARIANT_WIDTHS={"small":640,"medium":1280,"large":2200}
ARTFLOW_VARIANT_QUALITIES={"small":78,"medium":78,"large":82}
